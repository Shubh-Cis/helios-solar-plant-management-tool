{
  "name": "industry-project-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "node api/server.js",
    "seed": "node api/seed.js",
    "build": "rm -rf dist api/dist && npx --yes prisma@5 generate --schema=api/prisma/schema.prisma && vite build && (mkdir -p api/dist && cp -r dist/* api/dist || true)",
    "start": "npx --yes prisma@5 db push --schema=api/prisma/schema.prisma && node api/seed.js && node api/server.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@prisma/client": "^5.21.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "lucide-react": "^0.468.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "prisma": "^5.21.0",
    "puppeteer": "^25.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^2.15.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0"
  }
}
